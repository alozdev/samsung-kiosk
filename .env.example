# URL que se mostrará en la TV
KIOSK_URL=https://example.com

# redirect: la app navega directo a la URL (funciona con cualquier sitio)
# iframe:   la carga dentro de un iframe (permite auto-recarga, pero muchos sitios bloquean iframes)
KIOSK_MODE=redirect

# Solo modo iframe: recargar cada N minutos (0 = nunca)
KIOSK_RELOAD_MINUTES=0

# Perfil de certificado de Tizen Studio (Certificate Manager) usado para firmar
TIZEN_PROFILE=kiosk

# Basic auth (opcional, dejar vacío si el sitio no lo pide)
KIOSK_USER=
KIOSK_PASSWORD=

# Ruta de Tizen Studio si no está en C:\tizen-studio ni en el PATH (opcional)
TIZEN_HOME=
