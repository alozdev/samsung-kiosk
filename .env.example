# =============================================================================
# samsung-kiosk: configuration
# Copy this file to .env and edit it. Values are embedded into the app at
# build time (npm run build / npm run package): after any change you must
# package and install on the TV again. Full details in the README.
# =============================================================================

# --- Page ---------------------------------------------------------------------

# URL the TV will show (required). No user or password here: use
# KIOSK_USER / KIOSK_PASSWORD for that.
KIOSK_URL=https://example.com

# --- Load mode ----------------------------------------------------------------
# redirect  The app navigates to the URL and hands over the whole screen.
#           + Works with any site.
#           + The page receives every remote control key.
#           - The app ceases to exist: no zoom, no periodic reload, no
#             CH+/CH- keys. Anything you need must be done by the page itself.
#
# iframe    The app stays around the page and shows it in an iframe.
#           + Zoom (KIOSK_ZOOM and CH+/CH- on the remote) and periodic reload.
#           - The site must allow being embedded: if it sends X-Frame-Options
#             or CSP frame-ancestors, the screen stays black.
#
# Both modes: full screen, basic auth, sound, screen saver disabled and
# waiting for the network on start.
KIOSK_MODE=redirect

# --- iframe mode only (ignored in redirect) -----------------------------------

# Page scale: 1 = 100 %, 1.25 = 125 %, 0.8 = 80 %.
# "auto" = scale based on the panel's physical resolution (see README).
# On the TV, CH+/CH- adjust in multiples of 10 % and 0 returns to this value.
# Changing this value and reinstalling discards the adjustment made with the remote.
KIOSK_ZOOM=1

# Reload the page every N minutes (0 = never). Useful if the site doesn't
# refresh itself.
KIOSK_RELOAD_MINUTES=0

# --- Basic auth (optional) ----------------------------------------------------
# Leave empty if the site doesn't ask for a user and password. They are stored
# in plain text inside the .wgt: use a dedicated, read-only user if possible.
KIOSK_USER=
KIOSK_PASSWORD=

# --- TV -----------------------------------------------------------------------

# TV volume when the app opens (integer 0-100). The TV is always unmuted;
# empty = keep the current volume.
KIOSK_VOLUME=

# --- Build and signing --------------------------------------------------------

# Name of the Samsung certificate profile in the Certificate Manager.
TIZEN_PROFILE=kiosk

# Tizen Studio folder, only if it isn't in C:\tizen-studio, ~/tizen-studio,
# the VS Code extension's SDK or in PATH.
TIZEN_HOME=
